background = #121212
foreground = #bebebe
cursor-color = #bebebe
selection-background = #2a2a2a
selection-foreground = #bebebe

palette = 0=#121212
palette = 1=#D35F5F
palette = 2=#FFC107
palette = 3=#b91c1c
palette = 4=#e68e0d
palette = 5=#D35F5F
