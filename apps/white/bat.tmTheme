<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>name</key><string>White</string>
<key>settings</key>
<array>
<dict><key>settings</key><dict>
<key>background</key><string>#ffffff</string>
<key>foreground</key><string>#000000</string>
<key>caret</key><string>#000000</string>
<key>selection</key><string>#c0c0c0</string>
<key>lineHighlight</key><string>#c0c0c0</string>
<key>gutterForeground</key><string>#808080</string>
</dict></dict>
<dict><key>scope</key><string>comment, punctuation.definition.comment</string><key>settings</key><dict><key>foreground</key><string>#808080</string><key>fontStyle</key><string>italic</string></dict></dict>
<dict><key>scope</key><string>string, string.quoted</string><key>settings</key><dict><key>foreground</key><string>#3a3a3a</string></dict></dict>
<dict><key>scope</key><string>constant.numeric, constant.language, constant.character</string><key>settings</key><dict><key>foreground</key><string>#4a4a4a</string></dict></dict>
<dict><key>scope</key><string>constant.other, variable.other.constant</string><key>settings</key><dict><key>foreground</key><string>#4a4a4a</string></dict></dict>
<dict><key>scope</key><string>keyword, storage, storage.type, storage.modifier</string><key>settings</key><dict><key>foreground</key><string>#2e2e2e</string></dict></dict>
<dict><key>scope</key><string>keyword.operator, punctuation.separator, punctuation.accessor</string><key>settings</key><dict><key>foreground</key><string>#3e3e3e</string></dict></dict>
<dict><key>scope</key><string>entity.name.function, support.function, meta.function-call</string><key>settings</key><dict><key>foreground</key><string>#1a1a1a</string></dict></dict>
<dict><key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class</string><key>settings</key><dict><key>foreground</key><string>#4a4a4a</string></dict></dict>
<dict><key>scope</key><string>entity.name.tag</string><key>settings</key><dict><key>foreground</key><string>#2a2a2a</string></dict></dict>
<dict><key>scope</key><string>entity.other.attribute-name</string><key>settings</key><dict><key>foreground</key><string>#4a4a4a</string></dict></dict>
<dict><key>scope</key><string>variable.parameter</string><key>settings</key><dict><key>foreground</key><string>#2a2a2a</string></dict></dict>
<dict><key>scope</key><string>variable.language</string><key>settings</key><dict><key>foreground</key><string>#2a2a2a</string><key>fontStyle</key><string>italic</string></dict></dict>
<dict><key>scope</key><string>markup.heading, entity.name.section</string><key>settings</key><dict><key>foreground</key><string>#6e6e6e</string><key>fontStyle</key><string>bold</string></dict></dict>
<dict><key>scope</key><string>markup.bold</string><key>settings</key><dict><key>foreground</key><string>#000000</string><key>fontStyle</key><string>bold</string></dict></dict>
<dict><key>scope</key><string>markup.italic</string><key>settings</key><dict><key>foreground</key><string>#000000</string><key>fontStyle</key><string>italic</string></dict></dict>
<dict><key>scope</key><string>markup.underline.link, string.other.link</string><key>settings</key><dict><key>foreground</key><string>#3e3e3e</string><key>fontStyle</key><string>underline</string></dict></dict>
<dict><key>scope</key><string>markup.inserted</string><key>settings</key><dict><key>foreground</key><string>#3a3a3a</string></dict></dict>
<dict><key>scope</key><string>markup.deleted</string><key>settings</key><dict><key>foreground</key><string>#2a2a2a</string></dict></dict>
<dict><key>scope</key><string>markup.changed</string><key>settings</key><dict><key>foreground</key><string>#4a4a4a</string></dict></dict>
<dict><key>scope</key><string>invalid</string><key>settings</key><dict><key>foreground</key><string>#2a2a2a</string></dict></dict>
</array>
</dict>
</plist>
