<plist version="1.0">
<dict>
<key>name</key><string>Lupine</string>
<key>settings</key>
<array>
<dict><key>settings</key><dict>
<key>background</key><string>#fafafa</string>
<key>foreground</key><string>#212121</string>
<key>caret</key><string>#000000</string>
<key>selection</key><string>#d0d0d0</string>
<key>lineHighlight</key><string>#d0d0d0</string>
<key>gutterForeground</key><string>#9e9e9e</string>
</dict></dict>
<dict><key>scope</key><string>comment, punctuation.definition.comment</string><key>settings</key><dict><key>foreground</key><string>#9e9e9e</string><key>fontStyle</key><string>italic</string></dict></dict>
<dict><key>scope</key><string>string, string.quoted</string><key>settings</key><dict><key>foreground</key><string>#4a2fd0</string></dict></dict>
