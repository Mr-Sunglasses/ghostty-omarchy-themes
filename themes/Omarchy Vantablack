# Omarchy Vantablack
# Ported from Omarchy theme 'vantablack' (https://github.com/omacom/omarchy, commit 035ce29)

background = #000000
foreground = #ffffff
cursor-color = #ffffff
selection-background = #1a1a1a
selection-foreground = #ffffff

palette = 0=#000000
palette = 1=#a4a4a4
palette = 2=#b6b6b6
palette = 3=#cecece
palette = 4=#8d8d8d
palette = 5=#9b9b9b
palette = 6=#b0b0b0
palette = 7=#ffffff
palette = 8=#7a7a7a
palette = 9=#a4a4a4
palette = 10=#b6b6b6
palette = 11=#cecece
palette = 12=#8d8d8d
palette = 13=#9b9b9b
palette = 14=#b0b0b0
